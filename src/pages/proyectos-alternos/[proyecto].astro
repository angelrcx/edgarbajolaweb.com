---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Ficha from '../../components/Ficha.astro';
export async function getStaticPaths() {
  // los proyectos con `enlace` van directo al enlace y no necesitan página de detalle
  const todos = (await getCollection('alternos')).filter((e) => !e.data.enlace);
  return todos.map((e) => ({ params: { proyecto: e.id }, props: { e } }));
}
const { e } = Astro.props;
const { Content } = await render(e);
const desc = [e.data.titulo, e.data.artista, e.data.anio].filter(Boolean).join(' — ');
---
<BaseLayout titulo={e.data.titulo} descripcion={desc}>
  <Ficha entrada={e} Content={Content} volver="/proyectos-alternos" />
</BaseLayout>
