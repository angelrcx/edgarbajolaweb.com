---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
export async function getStaticPaths() {
  const albumes = await getCollection('alternos');
  return albumes.map((a) => ({ params: { proyecto: a.id }, props: { a } }));
}
const { a } = Astro.props;
const { Content } = await render(a);
---
<BaseLayout titulo={a.data.titulo} descripcion={`${a.data.titulo}, ${a.data.anio}`}>
  <article class="album">
    <Image src={a.data.portada} alt={`Portada de ${a.data.titulo}`} width={900} />
    <div>
      <h1>{a.data.titulo} <small>{a.data.anio}</small></h1>
      <div class="descripcion"><Content /></div>
      <ul class="links">
        {a.data.links.map((l) => <li><a href={l.url} target="_blank" rel="noopener">{l.plataforma}</a></li>)}
      </ul>
      <a href="/proyectos-alternos">Volver</a>
    </div>
  </article>
</BaseLayout>
