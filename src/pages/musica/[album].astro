---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
export async function getStaticPaths() {
  const albumes = await getCollection('albumes');
  return albumes.map((a) => ({ params: { album: a.id }, props: { a } }));
}
const { a } = Astro.props;
---
<BaseLayout titulo={a.data.titulo} descripcion={a.data.descripcion}>
  <article class="album">
    <Image src={a.data.portada} alt={`Portada de ${a.data.titulo}`} width={900} />
    <div>
      <h1>{a.data.titulo} <small>{a.data.anio}</small></h1>
      {a.data.descripcion && <p>{a.data.descripcion}</p>}
      <ul class="links">
        {a.data.links.map((l) => <li><a href={l.url} target="_blank" rel="noopener">{l.plataforma}</a></li>)}
      </ul>
      <a href="/musica">Volver</a>
    </div>
  </article>
</BaseLayout>
