---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CoverGrid from '../../components/CoverGrid.astro';
const albumes = (await getCollection('albumes')).sort((a, b) => a.data.orden - b.data.orden || a.data.titulo.localeCompare(b.data.titulo));
---
<BaseLayout titulo="Música">
  <h1 class="titulo">Música</h1>
  <CoverGrid items={albumes} base="/musica" />
</BaseLayout>
