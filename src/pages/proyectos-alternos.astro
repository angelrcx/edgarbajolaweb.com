---
import BaseLayout from '../layouts/BaseLayout.astro';
const proyectos = [
  { nombre: 'metal yami', texto: 'Descripción breve.', url: 'https://example.com' },
];
---
<BaseLayout titulo="Proyectos alternos">
  <h1 class="titulo">Proyectos alternos</h1>
  <section class="texto">
    <ul class="links">
      {proyectos.map((p) => (
        <li><a href={p.url} target="_blank" rel="noopener"><strong>{p.nombre}</strong><br />{p.texto}</a></li>
      ))}
    </ul>
  </section>
</BaseLayout>
