---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import FondoVideo from '../components/FondoVideo.astro';

// Imágenes del menú: src/assets/menu/<imagen>.jpg (o webp, png)
const imagenes = import.meta.glob<{ default: ImageMetadata }>('../assets/menu/*.{webp,png,jpg,jpeg,svg}', { eager: true });
const buscar = (nombre: string) =>
  Object.entries(imagenes).find(([ruta]) => ruta.includes(`/${nombre}.`))?.[1].default;

const secciones = [
  { href: '/intro', imagen: 'intro', label: 'Motivo' },
  { href: '/musica', imagen: 'musica', label: 'Música' },
  { href: '/produccion', imagen: 'produccion', label: 'Producción musical' },
  { href: '/videos', imagen: 'videos', label: 'Videos' },
  { href: '/fotografia', imagen: 'fotografia', label: 'Fotografía' },
  { href: '/arte-grafico', imagen: 'arte-grafico', label: 'Arte gráfico' },
  { href: '/poemario', imagen: 'poemario', label: 'Poemario' },
  { href: '/proyectos-alternos', imagen: 'proyectos-alternos', label: 'Proyectos alternos' },
];
---
<BaseLayout titulo="Edgar Bajo la Web" bar={false}>
  <FondoVideo />
  <section class="home">
    <h1 class="logo">Edgar Bajo la Web</h1>
    {secciones.map((s) => (
      <a class="tile" href={s.href}>
        {buscar(s.imagen) ? <Image src={buscar(s.imagen)!} alt={s.label} width={600} /> : s.label}
      </a>
    ))}
  </section>
</BaseLayout>
