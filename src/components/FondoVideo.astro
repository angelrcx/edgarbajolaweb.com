<div class="fondo-video" aria-hidden="true">
  <video autoplay muted loop playsinline preload="metadata" poster="/video/fondo-poster.jpg">
    <source src="/video/fondo.webm" type="video/webm" />
  </video>
</div>

<style>
  .fondo-video { position: fixed; inset: 0; z-index: -1; background: #000; }
  .fondo-video video { width: 100%; height: 100%; object-fit: cover; }
  /* capa oscura para que el texto se lea */
  .fondo-video::after { content: ""; position: absolute; inset: 0; background: rgba(0, 0, 0, .55); }
  /* si el usuario pidió menos movimiento, no se muestra el video */
  @media (prefers-reduced-motion: reduce) { .fondo-video video { display: none; } }
</style>